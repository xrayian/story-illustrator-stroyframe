# Storyframe — required environment variables (copy to .env and fill in)

# Postgres (Neon)
NEON_CONN_STRING=postgresql://user:password@host/db?sslmode=require

# Redis (Upstash, rediss:// for TLS)
UPSTASH_REDIS_URL=rediss://default:password@host:6379

# Cloudflare R2
R2_ACCOUNT_ID=32-hex-account-id
R2_ACCESS_KEY_ID=32-hex-access-key-id
R2_SECRET_ACCESS_KEY=64-hex-secret-access-key
R2_BUCKET=storyframe

# Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# ElevenLabs API (https://elevenlabs.io/app/settings/api-keys)
# ElevenLabs (OPTIONAL — voice stage). Without a key, stories use Edge TTS
# (free, unlimited Microsoft neural voices). Voice design requires paid plan.
ELEVENLABS_API_KEY=

# Edge TTS (OPTIONAL — free fallback when ElevenLabs is absent/quota-exhausted)
# No API key required. Uses Microsoft Edge neural voices (Aria, Guy, Jenny, etc.)
# Set to override the voice rate (default "+0%")
EDGE_TTS_RATE=

# Optional: model overrides (pipeline has sensible defaults)
GEMINI_ANALYSIS_MODEL=
# Image generation (Nano Banana). PAID feature — free-tier keys get quota
# limit 0; images then fall back to the free Pollinations.ai endpoint, or the
# story can skip visuals.
GEMINI_IMAGE_MODEL=
# Free Pollinations.ai fallback model (no API key needed)
POLLINATIONS_IMAGE_MODEL=flux

# Pruna P-API (https://docs.api.pruna.ai — PRIMARY image provider)
# OPTIONAL — free tier 250 req/min. Without a key, falls back to Gemini/HF/Pollinations.
PRUNA_API_KEY=
# Model: p-image (default), p-image-edit, flux-dev, etc.
PRUNA_IMAGE_MODEL=p-image
# Base URL: https://api.pruna.ai (default)
PRUNA_API_BASE_URL=

# Hugging Face image generation (OPTIONAL — https://huggingface.co/settings/tokens,
# hf-… token with Inference Providers permission). Middle fallback between
# Gemini and Pollinations. Without a token it's skipped.
HF_TOKEN=
# Model repo id, routed to a serving provider automatically
HF_IMAGE_MODEL=black-forest-labs/flux.1-schnell
ELEVENLABS_VOICE_DESIGN_MODEL=
ELEVENLABS_TTS_MODEL=

# Modal proxy for Qwen3.8-2.4T-A95B (OpenAI-compatible). PRIMARY story analyzer.
# Backup when Gemini Pro is 429/quota.
# baseURL https://xrayian--ep-qwen3-8-2-4t-a95b-server.us-west.modal.direct/v1, apiKey is "ID.SECRET"
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
# Optional overrides for the Modal Qwen endpoint
MODAL_QWEN_BASE_URL=https://xrayian--ep-qwen3-8-2-4t-a95b-server.us-west.modal.direct/v1
MODAL_QWEN_MODEL=Qwen/Qwen3.8-2.4T-A95B

# Modal Kimi K3 analysis fallback (OPTIONAL — OpenAI-compatible)
# Backup when Qwen is unavailable.
# baseURL https://xrayian--ep-kimi-k3-server.us-west.modal.direct/v1, apiKey is "ID.SECRET"
# Reuses MODAL_PROXY_TOKEN_ID + MODAL_PROXY_TOKEN_SECRET for auth
MODAL_KIMI_BASE_URL=https://xrayian--ep-kimi-k3-server.us-west.modal.direct/v1
MODAL_KIMI_MODEL=kimi-k3

# UI: explicitly show the analysis model badge. Set to "false" to hide. Default true.
NEXT_PUBLIC_SHOW_ANALYSIS_MODEL=true
# Server-side alias (also respected)
SHOW_ANALYSIS_MODEL=true